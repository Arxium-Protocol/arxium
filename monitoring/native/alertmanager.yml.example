# Copy to alertmanager.yml, configure at least one receiver, then run:
# sudo ALERTMANAGER=1 ./install-monitoring.sh
route:
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: default

receivers:
  - name: default
    # CONFIGURE_ME: enable a receiver below, then delete this marker.
    # Email example:
    # email_configs:
    #   - to: you@example.com
    #     from: alerts@example.com
    #     smarthost: smtp.example.com:587
    #     auth_username: alerts@example.com
    #     auth_password: "APP-PASSWORD"
    #     require_tls: true

    # Telegram example:
    # telegram_configs:
    #   - bot_token: "123456:ABC-DEF..."
    #     chat_id: 123456789
