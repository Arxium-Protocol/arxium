# Copy to .env (gitignored) and fill in before `docker compose -f docker-compose.prod.yml up -d`.

# Domain Nginx requests a TLS certificate for and terminates HTTPS on.
ARXD_DOMAIN=arxium.example.com

# Email used by Let's Encrypt for expiry notices.
ACME_EMAIL=ops@example.com

# Bearer token required on every RPC request (Authorization: Bearer <token>).
# Generate with: openssl rand -hex 32
# Must match the token set in Arx-Plus's Node Settings.
ARXD_RPC_TOKEN=
