{
  "name": "@arxium-protocol/sdk",
  "version": "0.1.0",
  "description": "Arxium TypeScript SDK and arx CLI",
  "type": "module",
  "private": false,
  "publishConfig": { "registry": "https://npm.pkg.github.com", "access": "restricted" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "arx": "./dist/cli.js" },
  "files": ["dist", "!dist/*.test.*", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": { "build": "tsc -p tsconfig.json", "test": "npm run build && node dist/codec.test.js" },
  "devDependencies": { "@types/node": "^20.0.0", "typescript": "^5.0.0" }
}
