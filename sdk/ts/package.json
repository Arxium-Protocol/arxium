{
  "name": "@arxium-protocol/sdk",
  "version": "0.4.0",
  "description": "Arxium TypeScript SDK and arx CLI",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arxium-Protocol/arxium.git",
    "directory": "sdk/ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "arx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.test.*",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node dist/codec.test.js && node dist/policy.test.js && node dist/cli.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
